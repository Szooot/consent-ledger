# Network RPC URLs
RPC_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
RPC_MAINNET=https://ethereum-rpc.publicnode.com

# Deployment keys (the deployer becomes the UsageLog admin)
PRIVATE_KEY_SEPOLIA=<your_sepolia_private_key>
PRIVATE_KEY_MAINNET=<your_mainnet_private_key>

# Key service address granted LOGGER_ROLE in UsageLog
LOGGER_ADDR_SEPOLIA=<logger_sepolia>
LOGGER_ADDR_MAINNET=<logger_mainnet>

# Source verification on Etherscan (one key works for every chain)
ETHERSCAN_API_KEY=<your_etherscan_api_key>

# Mainnet deploy and finalization commands require CONFIRM_MAINNET=yes.
# Replacing the mainnet manifest also requires --fresh --confirm-replace-mainnet-manifest.
